<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecossistema de Soluções Digitais</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                        'jakarta': ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
            min-height: 100vh;
        }
        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glass-card {
            background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.02) 100%);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s ease;
        }
        .glass-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .gradient-text {
            background: linear-gradient(135deg, #60a5fa 0%, #a855f7 50%, #34d399 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .section-gradient-1 {
            background: linear-gradient(180deg, #0f172a 0%, #1e3a5f 100%);
        }
        .section-gradient-2 {
            background: linear-gradient(180deg, #1e3a5f 0%, #312e81 100%);
        }
        .section-gradient-3 {
            background: linear-gradient(180deg, #312e81 0%, #1e1b4b 100%);
        }
        .glow {
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
            z-index: 0;
        }
    </style>
</head>
<body class="text-white">
    <!-- Navbar -->
    <nav class="fixed top-0 left-0 right-0 z-50 glass border-b border-white/10">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a href="#" class="text-2xl font-bold gradient-text">Soluções Digitais</a>
            <div class="hidden md:flex space-x-8">
                <a href="#home" class="hover:text-blue-400 transition-colors">Início</a>
                <a href="#projetos" class="hover:text-blue-400 transition-colors">Projetos</a>
                <a href="#contato" class="hover:text-blue-400 transition-colors">Contato</a>
            </div>
            <button class="md:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="section-gradient-1 min-h-screen flex items-center justify-center relative overflow-hidden pt-20">
        <div class="absolute top-20 left-10 w-72 h-72 bg-blue-500 rounded-full glow"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-600 rounded-full glow"></div>
        <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
            <h1 class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight">
                <span class="gradient-text">Ecossistema</span> de<br>
                <span class="text-white">Soluções Digitais</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 mb-10 max-w-2xl mx-auto">
                Transformando ideias em realidade digital. Projetos inovadores para impulsionar negócios e conectar comunidades.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href="#projetos" class="px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-full font-semibold hover:opacity-90 transition-opacity">
                    Ver Projetos
                </a>
                <a href="#contato" class="px-8 py-4 glass rounded-full font-semibold hover:bg-white/10 transition-colors">
                    Falar Conosco
                </a>
            </div>
        </div>
    </section>

    <!-- Grid de Projetos -->
    <section id="projetos" class="section-gradient-2 py-24 relative">
        <div class="absolute top-10 right-20 w-64 h-64 bg-green-500 rounded-full glow"></div>
        <div class="relative z-10 max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold mb-4">Nossos <span class="gradient-text">Projetos</span></h2>
                <p class="text-gray-400 text-lg max-w-2xl mx-auto">
                    Soluções digitais pensadas para atender às necessidades específicas de cada segmento.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
                <% projetos.forEach(function(projeto) { %>
                    <div class="glass-card rounded-2xl p-8 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br <%= projeto.cor %> opacity-20 rounded-full blur-2xl"></div>
                        <div class="relative z-10">
                            <span class="inline-block px-4 py-1 rounded-full text-sm font-medium bg-white/10 text-gray-200 mb-4">
                                <%= projeto.tag %>
                            </span>
                            <h3 class="text-2xl font-bold mb-3 text-white"><%= projeto.nome %></h3>
                            <p class="text-gray-300 mb-6 leading-relaxed"><%= projeto.descricao %></p>
                            <% var projetoLink = projeto.link || (projeto.id === 1 ? 'https://santafe-market.vercel.app/' : '#'); %>
                            <a href="<%= projetoLink %>" target="_blank" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r <%= projeto.cor %> rounded-lg font-semibold hover:opacity-90 transition-opacity">
                                <%= projeto.cta %>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Sobre Section -->
    <section class="section-gradient-3 py-24">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="text-4xl md:text-5xl font-bold mb-8">Por que escolher <span class="gradient-text">nossas soluções?</span></h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
                <div class="glass rounded-2xl p-6">
                    <div class="w-14 h-14 mx-auto mb-4 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">Inovação</h3>
                    <p class="text-gray-400">Tecnologias modernas para resultados eficientes.</p>
                </div>
                <div class="glass rounded-2xl p-6">
                    <div class="w-14 h-14 mx-auto mb-4 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">Especialistas</h3>
                    <p class="text-gray-400">Equipe qualificada e dedicada ao seu sucesso.</p>
                </div>
                <div class="glass rounded-2xl p-6">
                    <div class="w-14 h-14 mx-auto mb-4 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">Qualidade</h3>
                    <p class="text-gray-400">Compromisso com a excelência em cada projeto.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Rodapé -->
    <footer id="contato" class="py-16 glass border-t border-white/10">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
                <div>
                    <h4 class="text-2xl font-bold mb-4 gradient-text">Soluções Digitais</h4>
                    <p class="text-gray-400">Transformando o futuro através da tecnologia.</p>
                </div>
                <div>
                    <h4 class="text-xl font-semibold mb-4">Links Rápidos</h4>
                    <ul class="space-y-2">
                        <li><a href="#home" class="text-gray-400 hover:text-white transition-colors">Início</a></li>
                        <li><a href="#projetos" class="text-gray-400 hover:text-white transition-colors">Projetos</a></li>
                        <li><a href="#contato" class="text-gray-400 hover:text-white transition-colors">Contato</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xl font-semibold mb-4">Contato</h4>
                    <p class="text-gray-400 mb-2">contato@solucoesdigitais.com.br</p>
                    <p class="text-gray-400">+55 (17) 99999-9999</p>
                </div>
            </div>
            <div class="border-t border-white/10 pt-8 text-center">
                <p class="text-gray-500">© 2026 Soluções Digitais. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    <script>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
</body>
</html>